# ── PostgreSQL ──
POSTGRES_USER=agrocifra
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=agrocifra

# ── Backend ──
# Длинная случайная строка (например: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Создать демо-пользователей (org/region/office/gov) при первом запуске.
# После первичной инициализации в продакшене установите 0.
SEED_DEMO=1

# ── Jotform (опционально; ETL-загрузка анкет) ──
JOTFORM_API_KEY=
JOTFORM_API_BASE=https://eu-api.jotform.com
